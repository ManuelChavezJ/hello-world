[access]
	inheritFrom = All-Projects
[submit]
[project]
	description = hello world repository
[access "refs/*"]
	owner = group user/ManuelChavezJ
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/ManuelChavezJ
	label-Verified = -1..+1 group user/ManuelChavezJ
	push = group user/ManuelChavezJ
	read = group user/ManuelChavezJ
	rebase = group user/ManuelChavezJ
	removeReviewer = group user/ManuelChavezJ
	submit = group user/ManuelChavezJ
[access "refs/heads/*"]
	create = group user/ManuelChavezJ
	push = +force group user/ManuelChavezJ
	pushMerge = group user/ManuelChavezJ
	read = group user/ManuelChavezJ
[access "refs/tags/*"]
	push = group user/ManuelChavezJ
	push = +force group user/ManuelChavezJ
